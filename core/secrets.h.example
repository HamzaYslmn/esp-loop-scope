// Copy to secrets.h (gitignored) and fill in your router's 2.4 GHz network: the ESP32 has no
// 5 GHz radio. With it, the board only ever joins this network; without it, it opens its own,
// loop-scope (key loopscope), at http://192.168.4.1/.
#define WIFI_SSID "your-2.4GHz-network"
#define WIFI_PASS "its-password"
